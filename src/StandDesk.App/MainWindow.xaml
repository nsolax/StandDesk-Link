<Window x:Class="StandDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StandDesk" Icon="Resources/StandDesk.ico" Width="570" Height="750" MinWidth="510" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="22,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><TextBlock Text="StandDesk" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="DESK 2079" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <TabControl Grid.Row="1" x:Name="Navigation">
   <TabItem Header="Desk"><Grid Margin="10,20,10,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Refresh height"/><TextBlock Text="{Binding Connection}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></DockPanel>
    <Grid Grid.Row="1" Margin="0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Current height" Foreground="{DynamicResource Muted}" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Height}" FontSize="52" FontWeight="SemiBold"/><TextBlock Text="cm" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,12"/></StackPanel></StackPanel>
     <Canvas Grid.Column="1" Height="125" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False"><Rectangle Canvas.Left="2" Canvas.Bottom="0" Width="145" Height="1" Fill="{DynamicResource Line}"/><Rectangle x:Name="DeskTop" Canvas.Left="5" Canvas.Bottom="65" Width="135" Height="7" RadiusX="3" RadiusY="3" Fill="{DynamicResource Accent}"/><Rectangle x:Name="LeftLeg" Canvas.Left="23" Canvas.Bottom="4" Width="6" Height="61" Fill="{DynamicResource Accent}" Opacity="0.65"/><Rectangle x:Name="RightLeg" Canvas.Left="122" Canvas.Bottom="4" Width="6" Height="61" Fill="{DynamicResource Accent}" Opacity="0.65"/><Rectangle Canvas.Left="11" Canvas.Bottom="2" Width="30" Height="4" Fill="{DynamicResource Accent}"/><Rectangle Canvas.Left="111" Canvas.Bottom="2" Width="30" Height="4" Fill="{DynamicResource Accent}"/></Canvas>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Click="Sit_Click" IsEnabled="{Binding CanMove}" Padding="18" HorizontalContentAlignment="Left" AutomationProperties.Name="Move to sitting height"><StackPanel><TextBlock Text="↓  Sit" FontWeight="SemiBold"/><TextBlock Text="{Binding Sit,StringFormat={}{0} cm}" FontSize="25" Margin="0,14,0,12"/><TextBlock Text="{Binding SitKey}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Button>
     <Button Grid.Column="2" Click="Stand_Click" IsEnabled="{Binding CanMove}" Padding="18" HorizontalContentAlignment="Left" AutomationProperties.Name="Move to standing height"><StackPanel><TextBlock Text="↑  Stand" FontWeight="SemiBold"/><TextBlock Text="{Binding Stand,StringFormat={}{0} cm}" FontSize="25" Margin="0,14,0,12"/><TextBlock Text="{Binding StandKey}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Button>
    </Grid>
    <Button Grid.Row="3" Content="□  Stop movement" Foreground="{DynamicResource Danger}" Margin="0,14,0,0" MinHeight="44" Click="Stop_Click" AutomationProperties.Name="Stop movement"/>
    <StackPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ValidationNotice" Text="Movement will be enabled after the supervised hardware test." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="Heights"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,20,10,10" IsEnabled="{Binding CanEdit}">
    <TextBlock Text="Your heights" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Choose a height or save the desk’s current position." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,24"/>
    <TextBlock Text="Sitting height (cm)" Margin="0,0,0,8"/><WrapPanel><Button Content="−" Tag="sit:-0.1" Click="Step_Click" AutomationProperties.Name="Decrease sitting height"/><TextBox x:Name="SitInput" Width="100" Margin="6,0" AutomationProperties.Name="Sitting height in centimeters"/><Button Content="+" Tag="sit:0.1" Click="Step_Click" AutomationProperties.Name="Increase sitting height"/><Button Content="Use current height" Tag="sit" Click="Capture_Click" Margin="10,0,0,0"/></WrapPanel>
    <TextBlock Text="Standing height (cm)" Margin="0,24,0,8"/><WrapPanel><Button Content="−" Tag="stand:-0.1" Click="Step_Click" AutomationProperties.Name="Decrease standing height"/><TextBox x:Name="StandInput" Width="100" Margin="6,0" AutomationProperties.Name="Standing height in centimeters"/><Button Content="+" Tag="stand:0.1" Click="Step_Click" AutomationProperties.Name="Increase standing height"/><Button Content="Use current height" Tag="stand" Click="Capture_Click" Margin="10,0,0,0"/></WrapPanel>
    <TextBlock x:Name="RangeText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,22,0,8"/>
    <Expander Header="Operating range" Margin="0,8,0,14"><StackPanel Margin="0,12,0,0"><TextBlock Text="Use the desk paddle to reach a lower or upper position, then capture it here. These bounds limit automatic travel." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/><WrapPanel><Button Content="Capture lower bound" Tag="lower" Click="Capture_Click" Margin="0,0,8,0"/><Button Content="Capture upper bound" Tag="upper" Click="Capture_Click"/></WrapPanel></StackPanel></Expander>
    <TextBlock x:Name="HeightMessage" Text="Saving changes will not move the desk." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Muted}" Margin="0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" Click="CancelHeights_Click" Margin="0,0,8,0"/><Button Content="Save heights" Style="{StaticResource Primary}" Click="SaveHeights_Click"/></StackPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,20,10,10" IsEnabled="{Binding CanEdit}">
    <TextBlock Text="Make it yours" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Keyboard shortcuts and Windows preferences." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,16"/>
    <CheckBox x:Name="EnableHotkeys" Content="Enable keyboard shortcuts"/>
    <TextBlock Text="Sit shortcut" Margin="0,14,0,6"/><TextBox x:Name="SitKeyInput" AutomationProperties.Name="Sit keyboard shortcut"/>
    <TextBlock Text="Stand shortcut" Margin="0,14,0,6"/><TextBox x:Name="StandKeyInput" AutomationProperties.Name="Stand keyboard shortcut"/>
    <TextBlock Text="Stop shortcut" Margin="0,14,0,6"/><TextBox x:Name="StopKeyInput" AutomationProperties.Name="Stop keyboard shortcut"/>
    <TextBlock Text="Example: Ctrl+Alt+Shift+Up. Windows checks whether each shortcut is available." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10"/>
    <CheckBox x:Name="StartAtLogin" Content="Start when I sign in to Windows"/>
    <Button Content="Save settings" HorizontalAlignment="Right" Style="{StaticResource Primary}" Click="SaveSettings_Click" Margin="0,14,0,6"/>
    <TextBlock x:Name="SettingsMessage" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="12"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="6,16,6,0"><TextBlock Text="Bluetooth · DESK 2079" FontSize="12" Foreground="{DynamicResource Muted}"/><Button DockPanel.Dock="Right" Content="Exit" Click="Exit_Click" Padding="12,4" HorizontalAlignment="Right"/></DockPanel>
 </Grid>
</Window>
